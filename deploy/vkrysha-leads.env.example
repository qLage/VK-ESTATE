# Copy to /etc/vkrysha-leads.env on the server (chmod 600).
# Generate a long random token and give it only to the CRM agent.

LEADS_API_TOKEN=change-me-to-a-long-random-secret
LEADS_HOST=127.0.0.1
LEADS_PORT=8787
LEADS_DATA_DIR=/var/lib/vkrysha-leads

# CRM public intake (from CRM → Интеграции → site-leads). Never put this in frontend.
CRM_SITE_LEADS_URL=https://vkrysha-crm.ru/api/public/site-leads
CRM_SITE_LEADS_TOKEN=paste-token-from-crm-settings
